/FamilyName (Computer Modern) readonly def
/Weight (Medium) readonly def
/ItalicAngle 0 def
/isFixedPitch false def
/UnderlinePosition -100 def
/UnderlineThickness 50 def
end readonly def
/Encoding 256 array
0 1 255 {1 index exch /.notdef put} for
dup 91 /bracketleft put
dup 93 /bracketright put
dup 94 /circumflex put
dup 56 /eight put
dup 61 /equal put
dup 53 /five put
dup 52 /four put
dup 108 /l put
dup 22 /macron put
dup 110 /n put
dup 57 /nine put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 55 /seven put
dup 54 /six put
dup 51 /three put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
